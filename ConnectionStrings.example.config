<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to ConnectionStrings.config and fill in real values. ConnectionStrings.config is gitignored. -->
<connectionStrings>
    <add name="StudioConnectionString" connectionString="Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=DanceStudio;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;" providerName="System.Data.SqlClient" />
  </connectionStrings>
