<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="10thAveStudio.master.cs" Inherits="_10thAveStudioWeb._10thAveStudio" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>10th Avenue Studio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" sizes="32x32" href="img/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="img/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="img/apple-touch-icon.png">
    <link rel="shortcut icon" href="img/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&display=swap" rel="stylesheet">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        /* Reset and Base Styles */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Manrope', sans-serif;
            background-color: #000000;
            color: #FFFFFF;
            line-height: 1.5;
        }
        
        /* No-scroll class for when menu is open */
        body.no-scroll {
            overflow: hidden;
            position: fixed;
            width: 100%;
            height: 100%;
        }

        /* Typography */
        h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        /* Link Styling */
        a, a:visited, a:hover, a:active {
            color: #FFFFFF;
            text-decoration: none;
        }

        .nav-item a {
            display: inline-block;
            width: 100%;
            height: 100%;
            padding: 15px 0;
        }

        /* Header */
        .header {
            width: 100%;
            display: flex;
            border-bottom: 1px solid #333;
            position: relative;
        }

        .header-item {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px 10px;
            text-align: center;
        }

        .logo-container {
            flex: 0 0 20%;
        }

        .logo-container img {
            max-width: 180px;
            height: auto;
        }

        .nav-item {
            flex: 1;
        }

        .search-container {
            flex: 0 0 5%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .search-icon {
            width: 20px;
            height: auto;
        }

        /* Burger Menu */
        .burger-menu {
            display: none;
            flex: 0 0 auto;
            padding: 15px;
            cursor: pointer;
            z-index: 100;
            align-items: center; /* Center vertically */
            align-self: center; /* Center in flex container */
            margin-left: 10px; /* Add some margin */
        }

        .burger-icon {
            width: 30px;
            height: 20px;
            position: relative;
        }

        .burger-icon span {
            display: block;
            position: absolute;
            height: 3px;
            width: 100%;
            background: white;
            border-radius: 3px;
            opacity: 1;
            left: 0;
            transform: rotate(0deg);
            transition: .25s ease-in-out;
        }

        .burger-icon span:nth-child(1) {
            top: 0px;
        }

        .burger-icon span:nth-child(2) {
            top: 8px;
        }

        .burger-icon span:nth-child(3) {
            top: 16px;
        }

        .burger-icon.open span:nth-child(1) {
            top: 8px;
            transform: rotate(135deg);
        }

        .burger-icon.open span:nth-child(2) {
            opacity: 0;
            left: -60px;
        }

        .burger-icon.open span:nth-child(3) {
            top: 8px;
            transform: rotate(-135deg);
        }

        /* Mobile Navigation */
        .mobile-nav {
            display: block; /* Changed from none to block */
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: black;
            z-index: 99;
            padding-top: 60px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0; /* Start with 0 opacity */
            visibility: hidden; /* Hide it initially */
            transition: opacity 0.3s ease, visibility 0.3s ease; /* Add transition */
        }

        .mobile-nav.open {
            opacity: 1; /* Full opacity when open */
            visibility: visible; /* Make it visible */
        }

        .mobile-nav-item {
            padding: 15px;
            margin: 10px 0;
            font-size: 1.5rem;
            font-weight: bold;
            text-align: center;
            width: 100%;
            transform: translateY(20px); /* Start slightly down */
            opacity: 0; /* Start transparent */
            transition: transform 0.4s ease, opacity 0.4s ease; /* Add transition */
            transition-delay: calc(0.05s * var(--item-index, 0)); /* Staggered delay */
        }

        .mobile-nav.open .mobile-nav-item {
            transform: translateY(0); /* Move to original position */
            opacity: 1; /* Make fully visible */
        }

        /* Footer */
        .footer {
            width: 100%;
            display: flex;
            min-height: 200px;
            border-top: 1px solid #333;
        }

        .footer-left {
            flex: 0 0 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 30px;
        }

        .footer-logo {
            margin-bottom: 20px;
        }

        .footer-logo img {
            width: 80px;
            height: auto;
        }

        .footer-tagline img {
            max-width: 300px;
            height: auto;
            margin: 20px 0;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }

        .social-icon {
            width: 25px;
            height: auto;
        }

        .footer-right {
            flex: 0 0 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 30px;
            text-align: center;
        }

        .footer-text {
            max-width: 80%;
            margin-bottom: 20px;
        }

        /* Content Area */
        .content {
            min-height: calc(100vh - 300px); /* Adjust based on header/footer height */
        }

        /* Responsive Styles */
        @media (max-width: 992px) {
            .header {
                justify-content: space-between;
            }

            .burger-menu {
                display: flex;
                order: 1;
            }

            .logo-container {
                flex: 1;
                order: 2;
                justify-content: center;
            }

            .search-container {
                flex: 0 0 auto;
                order: 3;
                padding: 15px;
            }

            .nav-item {
                display: none;
            }

            .footer {
                flex-direction: column;
            }

            .footer-left, .footer-right {
                flex: 0 0 100%;
            }
        }

        @media (max-width: 576px) {
            .footer-text {
                max-width: 100%;
            }
        }
        .auto-style2 {
            width: 37px;
            height: 37px;
        }
        /* Mobile Navigation */
        .mobile-nav {
            display: block; /* Changed from none to block */
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #000000;
            z-index: 99;
            flex-direction: column;
            opacity: 0; /* Start with 0 opacity */
            visibility: hidden; /* Hide it initially */
            transition: opacity 0.3s ease, visibility 0.3s ease; /* Add transition */
        }

        .mobile-nav.open {
            opacity: 1; /* Full opacity when open */
            visibility: visible; /* Make it visible */
            display: flex;
        }

        /* Close button (X) */
        .close-button {
            position: fixed;
            top: 15px;
            left: 15px;
            width: 24px;
            height: 24px;
            cursor: pointer;
            z-index: 101;
        }

        /* Scrollable content area */
        .mobile-nav-content {
            margin-top: 60px; /* Space for fixed X button */
            margin-bottom: 80px; /* Space for fixed footer */
            overflow-y: auto;
            width: 100%;
            height: calc(100% - 140px);
            padding: 0;
        }

        .mobile-nav-item {
            padding: 20px 30px;
            font-size: 1.2rem;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transform: translateY(20px); /* Start slightly down */
            opacity: 0; /* Start transparent */
            transition: transform 0.4s ease, opacity 0.4s ease; /* Add transition */
            transition-delay: calc(0.05s * var(--delay, 0)); /* Staggered delay */
        }

        .mobile-nav.open .mobile-nav-item {
            transform: translateY(0); /* Move to original position */
            opacity: 1; /* Make fully visible */
        }

        .mobile-nav-item a {
            display: flex;
            width: 100%;
            justify-content: space-between;
            align-items: center;
        }

        .arrow-icon {
            font-size: 1.2rem;
        }

        /* Fixed footer */
        .mobile-nav-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background-color: #222222;
            padding: 20px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 101;
            transform: translateY(50px); /* Start below view */
            opacity: 0; /* Start transparent */
            transition: transform 0.4s ease, opacity 0.4s ease; /* Add transition */
            transition-delay: 0.3s; /* Delay appearance */
        }

        .mobile-nav.open .mobile-nav-footer {
            transform: translateY(0); /* Move to original position */
            opacity: 1; /* Make fully visible */
        }

        .login-container {
            display: flex;
            align-items: center;
        }

        .login-icon {
            width: 20px;
            height: 20px;
            margin-right: 10px;
        }

        .mobile-social-icons {
            display: flex;
            gap: 20px;
        }

        .mobile-social-icons img {
            width: 25px;
            height: 25px;
        }
        .auto-style3 {
            width: 100%;
            display: flex;
            position: relative;
            justify-content: space-between;
            align-items: center; /* Center items vertically */
            left: 0px;
            top: 0px;
            border-bottom: 1px solid #333;
        }
        .login-container a {
            display: flex;
            align-items: center;
        }
    </style>
    <script type="text/javascript">
        function toggleMenu() {
            document.querySelector('.burger-icon').classList.toggle('open');
            document.querySelector('.mobile-nav').classList.toggle('open');

            // Toggle no-scroll class on body
            document.body.classList.toggle('no-scroll');

            // Apply staggered delays to menu items
            if (document.querySelector('.mobile-nav').classList.contains('open')) {
                const menuItems = document.querySelectorAll('.mobile-nav-item');
                menuItems.forEach((item, index) => {
                    item.style.setProperty('--delay', index);
                });
            }
        }
    </script>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Header -->
        <header class="auto-style3">
            <!-- Burger Menu Button (mobile only) -->
            <div class="burger-menu" onclick="toggleMenu()">
                <div class="burger-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
            
            <!-- Logo -->
            <div class="header-item logo-container">
                <img alt="10th Avenue Studio Logo" src="img/logo.png" />
            </div>
            
            <!-- Desktop Navigation -->
            <div class="header-item nav-item">
                <h1>
                    <asp:HyperLink ID="HyperLink1" runat="server" NavigateUrl="~/WebForm2.aspx">Classes</asp:HyperLink>
                </h1>
            </div>
            <div class="header-item nav-item">
                <h1>
                    <asp:HyperLink ID="HyperLink2" runat="server" NavigateUrl="~/Schedules.aspx">Schedules</asp:HyperLink>
                </h1>
            </div>
            <div class="header-item nav-item">
                <h1>
                    <asp:HyperLink ID="HyperLink3" runat="server" NavigateUrl="~/Instructors.aspx">Instructors</asp:HyperLink>
                </h1>
            </div>
            <div class="header-item nav-item">
                <h1>
                    <asp:HyperLink ID="HyperLink4" runat="server" NavigateUrl="~/FAQs.aspx">FAQs</asp:HyperLink>
                </h1>
            </div>
            <!-- Contact Navigation Link -->
            <div class="header-item nav-item">
                <h1>
                    <asp:HyperLink ID="HyperLink5" runat="server" NavigateUrl="~/Contact.aspx">Contact</asp:HyperLink>
                </h1>
            </div>
            <!-- Rentals Navigation Link -->
            <div class="header-item nav-item">
                <h1>
                    <asp:HyperLink ID="HyperLink6" runat="server" NavigateUrl="~/Rentals.aspx">Rentals</asp:HyperLink>
                </h1>
            </div>
            
            <!-- Search Icon -->
            <div class="header-item search-container">
                <img alt="Search" class="search-icon" src="img/Searchh.png" />
            </div>
        </header>
        
        <!-- Mobile Navigation -->
        <nav class="mobile-nav">
            <!-- Scrollable content container -->
            <div class="mobile-nav-content">
                <div class="mobile-nav-item">
                    <asp:HyperLink ID="MobileHyperLink1" runat="server" NavigateUrl="~/WebForm2.aspx">Classes <span class="arrow-icon">→</span></asp:HyperLink>
                </div>
                <div class="mobile-nav-item">
                    <asp:HyperLink ID="MobileHyperLink2" runat="server" NavigateUrl="~/Schedules.aspx">Schedule <span class="arrow-icon">→</span></asp:HyperLink>
                </div>
                <div class="mobile-nav-item">
                    <asp:HyperLink ID="MobileHyperLink3" runat="server" NavigateUrl="~/Instructors.aspx">Instructors <span class="arrow-icon">→</span></asp:HyperLink>
                </div>
                <div class="mobile-nav-item">
                    <asp:HyperLink ID="MobileHyperLink4" runat="server" NavigateUrl="~/FAQs.aspx">FAQs</asp:HyperLink>
                </div>
                <div class="mobile-nav-item">
                    <asp:HyperLink ID="MobileHyperLink5" runat="server" NavigateUrl="~/Contact.aspx">Contact</asp:HyperLink>
                </div>
                <div class="mobile-nav-item">
                    <asp:HyperLink ID="MobileHyperLink6" runat="server" NavigateUrl="~/Rentals.aspx">Rentals</asp:HyperLink>
                </div>
            </div>
    
            <!-- Fixed footer with login and social icons -->
            <div class="mobile-nav-footer">
                <div class="login-container">
                    <asp:HyperLink ID="LoginHyperLink" runat="server" NavigateUrl="~/Login.aspx">
                        <img src="icons/icon.png" alt="User" class="login-icon">
                        <span>LOG IN</span>
                    </asp:HyperLink>
                </div>
        
                <div class="mobile-social-icons">
                    <a href="https://www.facebook.com/10thave.dancestudio"><img src="icons/fb.png" alt="Facebook"></a>
                    <a href="https://www.instagram.com/10thave.studio_"><img src="icons/ig.png" alt="Instagram"></a>
                    <a href="https://www.tiktok.com/@10thave_studio"><img src="icons/tiktok.png" alt="TikTok"></a>
                </div>
            </div>
        </nav>

        <!-- Content -->
        <div class="content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-left">
                <div class="footer-logo">
                    <img alt="10th Avenue Studio Logo" src="img/altlogo.png" />
                </div>
                <div class="footer-tagline">
                    <img alt="HOME OF THE SOUTH" src="img/tag.png" />
                </div>
                <div class="social-icons">
                    <a href="https://www.facebook.com/10thave.dancestudio"><img alt="Facebook" src="icons/fb.png" class="social-icon" /></a>
                    <a href="https://www.instagram.com/10thave.studio_"><img alt="Instagram" src="icons/ig.png" class="auto-style2" /></a>
                    <a href="https://www.tiktok.com/@10thave_studio"><img alt="TikTok" src="icons/tiktok.png" class="auto-style2" /></a>
                </div>
            </div>
            <div class="footer-right">
                <div class="footer-text">
                    <p>Discover a space designed for dancers, creators, and performers. Whether you're looking to take dynamic dance classes, rent a professional studio, capture stunning video and photos, or bring your dance vision to life, we've got you covered. Elevate your craft in a vibrant, inspiring environment.</p>
                </div>
                <p>© 2025 10th Ave Studio.</p>
            </div>
        </footer>
    </form>
</body>
</html>